{
  "name": "vibequest",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.1.1",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @vq/web --filter @vq/api dev",
    "build": "pnpm --filter @vq/web build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint apps packages tooling tests *.ts *.mjs",
    "format": "prettier --write apps packages tooling tests docs *.json *.yaml *.md *.ts *.mjs .github",
    "format:check": "prettier --check apps packages tooling tests docs *.json *.yaml *.md *.ts *.mjs .github",
    "hooks:install": "node tooling/workflow/install-hooks.mjs",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:browser": "pnpm build && playwright test",
    "architecture": "tsx tooling/architecture/check.ts",
    "db:migrate": "tsx packages/database/src/migrate.ts",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm architecture && pnpm test && pnpm build"
  },
  "devDependencies": {
    "next-intl": "4.14.9",
    "@vq/contracts": "workspace:*",
    "@vq/api-client": "workspace:*",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.0",
    "@types/node": "26.6.4",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.12.0",
    "prettier": "3.9.9",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vitest": "5.0.3"
  }
}
