# Export these into your shell; secrets are never committed.
DATABASE_URL=postgresql://vq_local@127.0.0.1:55439/vq_foundation
TEST_DATABASE_URL=postgresql://vq_local@127.0.0.1:55439/vq_test
API_ORIGIN=http://127.0.0.1:4100
PORT=4100
WEB_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
# Local development defaults to workspace .local/media without bucket credentials.
# Production/Railway environments require explicit MEDIA_STORAGE=railway.
MEDIA_STORAGE=local
# MEDIA_LOCAL_ROOT=
# Server-only Railway settings (set these only when MEDIA_STORAGE=railway):
# MEDIA_BUCKET_ENDPOINT=${{MediaBucket.ENDPOINT}}
# MEDIA_BUCKET_REGION=${{MediaBucket.REGION}}
# MEDIA_BUCKET_NAME=${{MediaBucket.BUCKET}}
# MEDIA_BUCKET_ACCESS_KEY_ID=${{MediaBucket.ACCESS_KEY_ID}}
# MEDIA_BUCKET_SECRET_ACCESS_KEY=${{MediaBucket.SECRET_ACCESS_KEY}}
# MEDIA_BUCKET_FORCE_PATH_STYLE=false
# Optional licensed HTTPS MapLibre styles; no map provider is provisioned.
NEXT_PUBLIC_MAP_STYLE_LIGHT=
NEXT_PUBLIC_MAP_STYLE_DARK=
